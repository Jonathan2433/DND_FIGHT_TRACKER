FLASK_APP=run.py
FLASK_CONFIG=preprod
SECRET_KEY=your_preprod_secret_key
SESSION_COOKIE_SECURE=true

POSTGRES_DB=exalquest_preprod
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@db:5432/exalquest_preprod

MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_DEFAULT_SENDER="ExalQuest Preprod <your_sender@example.com>"

OLLAMA_BASE_URL=http://jarvis_prod_ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=600