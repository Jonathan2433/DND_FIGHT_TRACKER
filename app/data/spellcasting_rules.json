  "non_spellcasting_classes": [
    "barbarian",
    "fighter",
    "monk",
    "rogue"
  ],
  "wizard_specific_rules": {
    "spellbook_entry_rules": {
      "starting_spellbook_entries_count": 6,
      "all_entries_must_be_level_1_wizard_spells_at_character_creation": true,
      "prepared_spells_must_be_subset_of_spellbook": true,
      "prepared_spells_count_at_level_1": 4
    },
    "ritual_adept": {
      "can_cast_ritual_tagged_wizard_spells_from_spellbook_without_preparing": true,
      "must_have_ritual_adept_feature": true
    }
  },
  "warlock_specific_rules": {
    "pact_magic": {
      "uses_pact_slots_instead_of_standard_spell_slots": true,
      "pact_slots_at_level_1": 1,
      "pact_slot_level_at_level_1": 1,
      "recharge": "short_or_long_rest"
    },
    "eldritch_invocations_can_grant_at_will_spells": true
  },
  "prepared_spell_rules": {
    "prepared_spells_must_come_from_class_spell_list_or_authorized_override": true,
    "prepared_spells_must_be_spell_level_1_or_lower_at_character_level_1": true,
    "cantrips_are_not_counted_against_prepared_spells": true,
    "always_prepared_spells_are_tracked_separately": true
  },
  "cantrip_rules": {
    "cantrips_use_known_selection_not_prepared_selection": true,
    "cantrips_count_separately_from_levelled_spells": true,
    "class_cantrips_must_come_from_class_catalog": true
  },
  "always_prepared_spell_rules": {
    "supported_sources": [
      "class_feature",
      "species_trait",
      "feat"
    ],
    "do_not_count_against_prepared_spells_limit": true,
    "count_as_class_spells_if_rule_says_so": true
  },
  "focus_rules": {
    "arcane_focus_supported_for": [
      "sorcerer",
      "warlock",
      "wizard"
    ],
    "holy_symbol_supported_for": [
      "cleric",
      "paladin"
    ],
    "druidic_focus_supported_for": [
      "druid",
      "ranger"
    ],
    "musical_instrument_supported_for": [
      "bard"
    ],
    "component_pouch_supported_for_all_spellcasting_classes": true
  },
  "magic_initiate_rules": {
    "source_feat_ids": [
      "magic_initiate",
      "magic_initiate_cleric",
      "magic_initiate_druid",
      "magic_initiate_wizard"
    ],
    "choose_two_cantrips_and_one_level_1_spell": true,
    "allowed_lists": [
      "cleric",
      "druid",
      "wizard"
    ],
    "chosen_level_1_spell_is_always_prepared": true,
    "free_casts_of_chosen_level_1_spell": 1,
    "free_cast_recharge": "long_rest",
    "can_also_cast_with_any_available_spell_slots": true,
    "spellcasting_ability_must_be_chosen_from": [
      "intelligence",
      "wisdom",
      "charisma"
    ]
  },
  "species_granted_spell_rules": {
    "species_spellcasting_ability_may_require_choice": true,
    "species_spells_are_tracked_separately_from_class_prepared_spells": true,
    "future_species_spells_remain_locked_until_required_level": true
  },
  "validation_rules": {
    "spellcasters_must_have_valid_spellcasting_ability": true,
    "spellcasters_must_have_legal_cantrip_count": true,
    "spellcasters_must_have_legal_prepared_spell_count": true,
    "wizard_must_have_legal_spellbook_entries": true,
    "warlock_must_use_pact_magic_rules": true,
    "all_spell_choices_must_reference_existing_spell_ids": true,
    "all_spell_choices_must_match_allowed_source_catalog": true
  },
  "json_dependencies": {
    "core": [
      "class_catalog.json",
      "class_features.json",
      "spells.json",
      "spells_by_class.json"
    ],
    "choice_resolution": [
      "subchoices_catalog.corrected.json",
      "class_choice_rules.corrected.json",
      "species_choice_rules.json",
      "feat_choices_rules.corrected.json"
    ],
    "feats_and_species": [
      "origin_feats.json",
      "species.json"
    ]
  }
}