{
  "id": "spellcasting_rules",
  "rules_version": "dnd_5_2024",
  "entity_type": "ruleset",
  "available_at_character_level": 1,
  "builder_scope": "level_1_character_creation_only",
  "global_spellcasting_rules": {
    "spells_json_source": "spells.json",
    "spells_by_class_source": "spells_by_class.json",
    "subchoices_catalog_source": "subchoices_catalog.corrected.json",
    "only_spell_levels_in_scope": [
      0,
      1
    ],
    "spellcasting_focus_required_if_material_component_without_cost": true,
    "component_pouch_supported": true,
    "spell_save_dc_formula": "8 + proficiency_bonus + spellcasting_ability_modifier",
    "spell_attack_bonus_formula": "proficiency_bonus + spellcasting_ability_modifier",
    "ritual_casting_supported": true,
    "concentration_supported": true,
    "duplicate_spells_in_same_spell_list_selection_not_allowed": true,
    "species_or_feat_granted_spells_do_not_expand_class_spell_list": true,
    "always_prepared_spells_do_not_count_against_prepared_spells_limit_unless_rule_says_otherwise": true,
    "class_choice_rules_source": "class_choice_rules.corrected.json",
    "feat_choice_rules_source": "feat_choices_rules.corrected.json",
    "species_choice_rules_source": "species_choice_rules.json"
  },
