    "name_en": "Cleave",
    "rules_version": "dnd_5_2024",
    "entity_type": "weapon_mastery",
    "available_at_character_level_1": true,
    "trigger": {
      "event": "on_hit",
      "requires": [
        "melee_attack_roll",
        "weapon_with_this_mastery"
      ]
    },
    "effect": {
      "type": "extra_attack_roll_against_second_creature",
      "target_rule": {
        "second_creature_within_feet_of_first_target": 5,
        "second_creature_must_also_be_within_your_reach": true
      },
      "damage_on_hit": {
        "use_weapon_damage": true,
        "add_ability_modifier": false,
        "unless_modifier_negative": true
      }
    },
    "limits": {
      "max_uses_per_turn": 1
    },
